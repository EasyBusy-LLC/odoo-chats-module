<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_easy_busy_chats" model="ir.ui.view">
        <field name="name">res.partner.form.easy_busy_chats</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Chats" name="easy_busy_chats" groups="easy_busy_chats.group_easy_busy_chats_user">
                    <field name="easy_busy_chat_link_ids" nolabel="1" context="{'default_partner_id': active_id}" options="{'no_create': True, 'form_view_ref': 'easy_busy_chats.view_easy_busy_chat_link_form'}">
                        <tree create="0" delete="1" edit="0" class="o_easy_busy_chats_tree">
                            <field name="provider"/>
                            <field name="chat_title"/>
                            <field name="contact_id" />
                            <field name="contact_user_name"/>
                            <button name="action_open_chat" type="object" string="Go to Chat" class="btn btn-secondary oe_easy_busy_chat_redirect" icon="fa-external-link"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_easy_busy_chat_link_form" model="ir.ui.view">
        <field name="name">easy.busy.chat.link.form</field>
        <field name="model">easy.busy.chat.link</field>
        <field name="arch" type="xml">
            <form string="Messenger Chat">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="provider" readonly="1"/>
                        </group>
                        <group>
                            <field name="account_id" readonly="1" invisible="1"/>
                            <field name="chat_id" readonly="1"/>
                            <field name="chat_title" readonly="1"/>
                        </group>
                        <group>
                            <field name="contact_id" readonly="1"/>
                            <field name="contact_user_name" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="redirect_url" invisible="1"/>
                        <label for="redirect_url" class="o_form_label"/>
                        <div class="oe_easy_busy_chat_redirect">
                            <button name="action_open_chat" type="object" string="Go to Chat" class="btn btn-secondary oe_easy_busy_chat_redirect" icon="fa-external-link"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
